# Périmètre du dépôt : DLL, dépendances de compilation et mod prêt à installer.
# tools/, docs/, TEST_LOG.md, prototypes et sauvegardes restent en local.
/*
!/.gitignore
!/LICENSE
!/README.md
!/.github/
!/install-linux.sh
!/install-windows.ps1
!/dll/
!/external/
!/mods/

/.github/*
!/.github/workflows/
!/.github/package-release.py
!/.github/images/
/.github/images/*
!/.github/images/stamp-folders.png
!/.github/images/stamp-library.png

/dll/*
!/dll/Makefile.native-ui
!/dll/src/
/dll/src/*
!/dll/src/dbghelp.def
!/dll/src/dllmain_pipette.c
!/dll/src/native_stamp.c
!/dll/src/native_stamp.h
!/dll/src/native_catalogue.c
!/dll/src/native_catalogue.h
!/dll/src/native_library.c
!/dll/src/native_icons.c
!/dll/src/native_management.h
!/dll/src/native_management.inc

# Dépendances compilées dans la DLL : sources et licences, sans sous-module.
/external/*
!/external/minhook/
!/external/miniz/
/external/minhook/*
!/external/minhook/include/
!/external/minhook/src/
!/external/minhook/LICENSE.txt
/external/minhook/include/*
!/external/minhook/include/MinHook.h
/external/minhook/src/*
!/external/minhook/src/buffer.c
!/external/minhook/src/buffer.h
!/external/minhook/src/hook.c
!/external/minhook/src/trampoline.c
!/external/minhook/src/trampoline.h
!/external/minhook/src/hde/
/external/minhook/src/hde/*
!/external/minhook/src/hde/hde64.c
!/external/minhook/src/hde/hde64.h
!/external/minhook/src/hde/pstdint.h
!/external/minhook/src/hde/table64.h
/external/miniz/*
!/external/miniz/*.c
!/external/miniz/*.h
!/external/miniz/LICENSE
!/external/miniz/README.anno117.md

/mods/*
!/mods/anno117-stamps-native-ui/

# Produits de compilation, caches et journaux, même dans les dossiers conservés.
**/build/
**/bin/
**/obj/
**/__pycache__/
*.py[cod]
*.o
*.obj
*.so
*.a
*.dll
*.exe
*.lib
*.pdb
*.exp
*.ilk
*.log
*.tmp
*.rda
*.a7s
*.a8s
.env
.env.*
.venv/
venv/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
